{
  "name": "dungeon-architect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm test && npm run test:e2e",
    "format": "prettier --write src tests scripts *.ts *.json index.html docs README.md .github/workflows",
    "native:sync": "npm run build && cap sync",
    "android:debug": "npm run native:sync && cd android && gradlew.bat assembleDebug",
    "native:android": "cap open android",
    "native:ios": "cap open ios"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
